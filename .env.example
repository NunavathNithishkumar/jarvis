# JARVIS Phase 2 configuration example. Copy values into your Windows *user* environment
# (recommended) or a local .env that you load yourself. Never commit real keys.
# Provider: openrouter (default, chosen by the user) or openai
JARVIS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-REPLACE_ME
# Optional; default anthropic/claude-sonnet-5.5 (must support tool calling)
JARVIS_OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Only if JARVIS_LLM_PROVIDER=openai:
# OPENAI_API_KEY=sk-REPLACE_ME
# JARVIS_OPENAI_MODEL=REPLACE_WITH_OPENAI_MODEL_ID
JARVIS_LLM_TIMEOUT_S=60
JARVIS_LLM_MAX_RETRIES=2
JARVIS_LLM_MAX_TOKENS=2048
# Per-task ceilings
JARVIS_TASK_MAX_LLM_CALLS=40
JARVIS_TASK_MAX_TOKENS=150000
JARVIS_TASK_MAX_COST_USD=1.00
JARVIS_TASK_MAX_REPLANS=2
JARVIS_TASK_MAX_WALL_S=900
# Live desktop tests only (operator pre-authorization):
# JARVIS_LIVE_TESTS_AUTHORIZED=1
# JARVIS_LIVE_RUNS=3
